# ═══════════════════════════════════════════════════════════════
# Krishi Mitra — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git!
# All VITE_ prefixed vars are exposed to the browser bundle.
# For secrets that must stay server-side, use Vercel Environment
# Variables WITHOUT the VITE_ prefix.
# ═══════════════════════════════════════════════════════════════

# ── Firebase (client-side — safe to expose) ────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Weather API ────────────────────────────────────────────────
# Get your free key at: https://www.weatherapi.com/
# NOTE: In production, set WEATHER_API_KEY (no VITE_ prefix) on
# Vercel and use the serverless proxy at /api/weather
VITE_WEATHER_API_KEY=

# ── PlantNet (Crop Identification) ─────────────────────────────
# Get your free key at: https://my.plantnet.org/settings/api-key
# NOTE: In production, set PLANTNET_API_KEY (no VITE_ prefix) on
# Vercel — the serverless proxy at /api/plantnet uses it.
VITE_PLANTNET_API_KEY=
